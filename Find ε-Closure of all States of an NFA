#include <stdio.h>

int n;
int epsilon[10][10];
int visited[10];

/* Find epsilon closure of a state */
void epsilonClosure(int state)
{
    int i;

    visited[state] = 1;
    printf("%d ", state);

    for (i = 0; i < n; i++)
    {
        if (epsilon[state][i] && !visited[i])
        {
            epsilonClosure(i);
        }
    }
}

int main()
{
    int i, j;

    printf("========================================\n");
    printf("       EPSILON CLOSURE OF AN NFA\n");
    printf("========================================\n\n");

    /* Input number of states */
    printf("Enter the number of states: ");
    scanf("%d", &n);

    /* Input epsilon transition matrix */
    printf("\nEnter the epsilon transition matrix:\n");
    printf("(Enter 1 for epsilon transition, 0 otherwise)\n\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &epsilon[i][j]);
        }
    }

    /* Calculate epsilon closure for each state */
    printf("\n========================================\n");
    printf("           EPSILON CLOSURES\n");
    printf("========================================\n");

    for (i = 0; i < n; i++)
    {
        /* Reset visited array */
        for (j = 0; j < n; j++)
        {
            visited[j] = 0;
        }

        printf("E(%d) = { ", i);
        epsilonClosure(i);
        printf("}\n");
    }

    printf("========================================\n");

    return 0;
}
