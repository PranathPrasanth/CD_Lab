#include <stdio.h>

void main(){
    
    int i,j,n;
    int trans[10][2];
    
    printf("Enter no of states: ");
    scanf("%d",&n);
    
    printf("Enter transitions for 0 and 1:\n");
    
    for(i=0;i<n;i++){
        
        printf("State %d: \n",i);
        scanf("%d%d",&trans[i][0],&trans[i][1]);
    }
    
    printf("Equivalent DFA\n");
    
    printf("State\t0\t1\n");
    
    for(i=0;i<n;i++){
        
        printf("%d\t%d\t%d\n",i,trans[i][0],trans[i][1]);
    }
    
}
